@PACKAGE_INIT@

# hepmc_phlexConfig.cmake
#
# find_package(hepmc_phlex REQUIRED)
# target_link_libraries(my_target PRIVATE hepmc_phlex::hepmc_phlex)

include(CMakeFindDependencyMacro)
# spdlog / TBB / fmt must be found BEFORE phlex (Framework-R-D/phlex#656; see
# ddm-ovy).  Remove once upstream find_dependency is fixed.
find_dependency(Boost REQUIRED COMPONENTS json)
find_dependency(TBB REQUIRED)
find_dependency(spdlog REQUIRED)
find_dependency(fmt REQUIRED)
find_dependency(phlex REQUIRED)
find_dependency(HepMC3 REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/hepmc_phlexTargets.cmake")

check_required_components(hepmc_phlex)
